{
  "name": "@inbox-zero/api",
  "version": "2.29.2",
  "description": "CLI tool for managing InboxJarvis through the external API",
  "keywords": [
    "inboxjarvis",
    "api",
    "cli",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv182124/InboxJarvis.git",
    "directory": "packages/api"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "inbox-zero-api": "bin/inbox-zero-api.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outfile bin/inbox-zero-api.js --target node",
    "dev": "bun run src/main.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
